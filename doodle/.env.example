SESSION_SECRET=
# Apple sign-in server configuration. Keep private values off the mobile bundle.
APPLE_TEAM_ID=
APPLE_SIGN_IN_CLIENT_ID=nl.samistudio.doodle
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
# Separate stable 32-byte base64url key for encrypted Apple revocation tokens.
# Never replace SESSION_SECRET to configure Apple; existing identities depend on it.
APPLE_AUTHORIZATION_ENCRYPTION_KEY=
# Protected iPhone generation. Keep disabled until physical verification.
APPLE_APP_ATTEST_ENABLED=false
APPLE_APP_ATTEST_ENVIRONMENT=production
APPLE_APP_ATTEST_BUILDS=1
# Apple consumable purchases. Enable only after Paid Apps and products are ready.
APPLE_BILLING_ENABLED=false
APPLE_IAP_PRODUCTS_CONFIRMED=false
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
# Optional rollback: set to off to return provider PNGs without paper correction.
DOODLE_PAPER_CORRECTION=on
KV_REST_API_URL=
KV_REST_API_TOKEN=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DOODLE_PRICE_ID=
