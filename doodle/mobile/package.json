{
  "name": "@samistudio/doodle-mobile",
  "version": "0.1.9",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prepare:ios": "expo prebuild --platform ios --no-install && node scripts/check-ios-project.mjs && pod install --project-directory=ios",
    "ios": "npm run prepare:ios && expo run:ios --no-install",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "preflight:ios": "node scripts/check-ios-project.mjs",
    "build:fixture": "node scripts/build-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:photo:ios": "node scripts/test-ios-photo.mjs",
    "test:watch": "vitest",
    "doctor": "expo doctor"
  },
  "dependencies": {
    "@expo/app-integrity": "57.0.1",
    "@expo/vector-icons": "15.1.1",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "57.0.3",
    "expo-asset": "57.0.19",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-iap": "5.5.1",
    "expo-image": "57.0.5",
    "expo-image-manipulator": "57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "57.0.2",
    "expo-media-library": "57.0.5",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.11",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
